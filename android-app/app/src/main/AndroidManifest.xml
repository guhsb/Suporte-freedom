<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:label="Freedom Suporte Remoto"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de primeira abertura: escaneia o QR de pareamento gerado
             pelo admin e salva a configuração localmente. -->
        <activity
            android:name=".QRScanActivity"
            android:exported="false" />

        <!--
          Serviço em primeiro plano que mantém a captura de tela + conexão WebRTC
          viva, e MOSTRA O AVISO FIXO obrigatório de sessão remota ativa.
        -->
        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Fica com o GPS ligado durante o expediente configurado e manda
             um ponto a cada ~5 min (localização + velocidade). -->
        <service
            android:name=".LocationTrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Captura localização a cada 5 min, só durante o expediente
             configurado em LocationTrackingService.kt. -->
        <service
            android:name=".LocationTrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!--
          Serviço de acessibilidade que executa os toques/gestos recebidos
          do controlador. Precisa estar na lista de "permitted accessibility
          services" do Device Owner (Headwind) para ligar sem o usuário aceitar.
        -->
        <service
            android:name=".RemoteControlAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
